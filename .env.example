# Copy to .env.local for local development. Never commit real secrets.
# Supabase's publishable/anonymous key is safe for the client only because RLS is enforced.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UNIVERSITY_EMAIL_DOMAIN=nyu.edu

# Server-only rate-limit bookkeeping for magic-link requests. Never expose to browsers.
# Required by the production login throttle if no alternative limiter is configured.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit local fixture preview only. Keep false in every real deployment.
DEMO_MODE=false

# Direct or session-pooler PostgreSQL connection for migration/admin commands only.
# Never prefix database credentials or service-role credentials with NEXT_PUBLIC_.
DATABASE_URL=

# Optional ingestion credentials; only needed by the separate Python pipeline.
GEMINI_API_KEY=
# Choose a structured-output model enabled in your Gemini account.
GEMINI_MODEL=
INGESTION_DATABASE_URL=

# Optional local scraper session. Never configure these in the web deployment.
FB_C_USER=
FB_XS=
ROR_GROUP_ID=
